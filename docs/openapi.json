    "/api/tickets/{ticket_id}/status": {
      "patch": {
        "tags": [
          "tickets"
        ],
        "summary": "Change Status",
        "description": "NEW→IN_PROGRESS→RESOLVED만 허용. 미배정 진행·역방향은 409. 같은 상태는 200(멱등).",
        "operationId": "change_status_api_tickets__ticket_id__status_patch",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Ticket Id"
