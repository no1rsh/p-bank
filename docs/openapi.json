{
  "openapi": "3.1.0",
  "info": {
    "title": "BankDesk AI API",
    "description": "bankdesk_contract_v1 / 기준서 v2.2 (팀 승인 대기). 가상 은행 데모 — 실제 개인정보 입력 금지.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/tickets": {
      "post": {
        "tags": [
          "tickets"
        ],
        "summary": "Create Ticket",
        "description": "고객 문의 접수. 모델 장애여도 DB 저장 성공이면 201(REVIEW). DB 실패는 500.",
        "operationId": "create_ticket_api_tickets_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        }
      },
      "get": {
        "tags": [
          "tickets"
        ],
        "summary": "List Tickets",
        "description": "목록. 정렬 created_at DESC, ticket_id DESC. review_pending=true → 최초 REVIEW + 현재 팀 null.",
        "operationId": "list_tickets_api_tickets_get",
        "parameters": [
          {
            "name": "work_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "NEW",
                    "IN_PROGRESS",
                    "RESOLVED"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Work Status"
            }
          },
          {
            "name": "routing_decision",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "AUTO",
                    "REVIEW"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Routing Decision"
            }
          },
          {
            "name": "assigned_team_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "CARD",
                    "TRANSFER",
                    "PAYMENT",
                    "ATM",
                    "ACCOUNT"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Assigned Team Code"
            }
          },
          {
            "name": "review_pending",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Review Pending"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketList"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        }
      }
    },
